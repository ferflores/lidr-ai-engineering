# Copia este archivo a `.env` y rellena la API key del proveedor que vayas a usar.
# `.env` está en .gitignore: nunca se sube al repositorio.

# Proveedor LLM: openai | anthropic
LLM_PROVIDER=openai

# API keys (solo hace falta la del proveedor elegido)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos económicos recomendados por el curso
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Versión de la plantilla de prompt (carpeta prompts/estimacion/<versión>). Para cambiar el prompt
# se crea una versión nueva y se activa aquí; una petición puede pedir otra con "prompt_version".
PROMPT_VERSION=v4

# Sesiones conversacionales (sesión 05): turnos (par user+assistant) que conserva la ventana deslizante
# del historial de cada sesión, y tope de sesiones vivas en memoria del proceso.
SESSION_MAX_TURNS=6
SESSION_MAX_SESSIONS=500

# Adjuntos (PDF, Word .docx, texto): ficheros por petición, bytes por fichero y caracteres extraídos por fichero
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_CHARS=60000

# URL de la API para la interfaz de Streamlit (streamlit_app.py habla con la API por HTTP)
API_BASE_URL=http://localhost:8000

# Parámetros del modelo
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Precios en USD por millón de tokens, para calcular el coste de cada llamada.
# Opcionales: si no se definen se usa la tabla de app/services/pricing.py según el modelo.
# LLM_INPUT_PRICE_PER_MTOK=0.15
# LLM_OUTPUT_PRICE_PER_MTOK=0.60

# --- Sesión 05 (directo) / pre-work sesión 06: compresión del historial, tier, caché y observación ---
# Anclas heurísticas: hechos del cliente que sobreviven a la ventana (0 las desactiva) y tope por turno.
ANCHORS_MAX=24
ANCHORS_PER_TURN=6
# Resumen acumulativo de los turnos que salen de la ventana: llm (una llamada extra, prompts/resumen/v1),
# heuristic (sin llamadas) u off (el turno se descarta como en el pre-work 05). Tope de caracteres del resumen.
SUMMARY_MODE=llm
SUMMARY_MAX_CHARS=1500
# Tier dinámico (app/services/tiering.py): umbrales para resolver "extended". Por defecto el tier extended usa
# el mismo modelo y los mismos tokens que el estándar (solo se observa); descomenta para que tenga efecto.
TIER_EXTENDED_MIN_CONTEXT_CHARS=40000
TIER_EXTENDED_MIN_ATTACHMENT_CHARS=15000
# TIER_EXTENDED_MODEL=gpt-4o
# TIER_EXTENDED_MAX_TOKENS=8192
# Caché de respuestas en memoria del proceso: exacta (mismo prompt) y semántica (Jaccard >= umbral sobre el mensaje actual).
RESPONSE_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.9
# Formato de los eventos structlog (turn_observed): json | console
LOG_FORMAT=json

# --- Pre-work sesión 07: pipeline de embeddings (POST /embeddings/ingest) ---
# Los embeddings se generan siempre con OpenAI (OPENAI_API_KEY), independientemente de LLM_PROVIDER.
# Modelo fijado por el curso (1536 dimensiones) y tamaño de lote por llamada a la API.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# --- Pre-work sesión 08: PostgreSQL + pgvector (persistencia y POST /search) ---
# Driver async (asyncpg), el recomendado por SQLAlchemy 2.0. Este valor por defecto es el del desarrollo
# local con `uv run` contra el Postgres de compose, que publica el 5432 en el host. Dentro de la red de
# compose el host es el nombre del servicio (`postgres`), y docker-compose.yml ya lo sobrescribe.
# Las credenciales de ejemplo son las del compose: es una base de desarrollo, no hay nada que proteger.
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator

# --- Sesión 04 (hueco cerrado): guardrails de entrada y salida ---
# log = evalúa y registra sin bloquear (recomendado para empezar); enforce = bloquea; off = desactivados.
GUARDRAILS_MODE=log
# Moderación de OpenAI sobre la transcripción (gratuita). Necesita OPENAI_API_KEY.
GUARDRAILS_MODERATION=true

# Backend de la caché semántica: jaccard (palabras, determinista, gratis) o embeddings (significado,
# una llamada a la API de embeddings por consulta).
SEMANTIC_CACHE_BACKEND=jaccard
# Umbral del backend de embeddings. No es el mismo número que SEMANTIC_CACHE_THRESHOLD, que es el de
# Jaccard. Calibrado sobre peticiones de este dominio en docs/calibracion-cache-semantica.md.
SEMANTIC_CACHE_THRESHOLD_EMBEDDINGS=0.75

# --- Sesión 03 (hueco cerrado): wrapper de proveedores ---
# sdk = SDK oficial de cada proveedor (por defecto, el usado en las entregas);
# litellm = agregador con la convención de OpenAI para todos los proveedores.
LLM_BACKEND=sdk
LITELLM_RETRIES=2

# --- Pre-work sesión 10: búsqueda híbrida y reranking (POST /search) ---
# Los dos interruptores del ejercicio. Son los valores por defecto del servicio; cada petición a /search
# puede sobrescribirlos con `mode` y `rerank`, que es como evals/retrieval/run.py mide las cuatro
# configuraciones (A vector / B hybrid / C vector+rerank / D hybrid+rerank) contra un mismo servicio.
# vector = solo distancia coseno; hybrid = coseno + full-text de PostgreSQL fusionados con Reciprocal Rank Fusion.
SEARCH_MODE=hybrid
# Anchura del recall antes de fusionar/reordenar (recall-then-rerank: top-N -> top-k).
SEARCH_CANDIDATES=50
# Constante de suavizado de RRF: score = sum(1 / (k + rank)). 60 es el valor del paper original.
RRF_K=60
# Reranking con cross-encoder (sentence-transformers, local, CPU). true lo enciende sin tocar código. Apagado por
# defecto: medido sobre el golden set triplica la latencia (+600-780 ms en CPU) y baja la precisión@5 (ver README).
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_BATCH_SIZE=32
RERANK_MAX_LENGTH=512
# Dispositivo de torch (cpu | cuda | mps). cpu es la referencia de producción (el contenedor no tiene GPU).
RERANK_DEVICE=cpu
# Cargar el modelo al arrancar cuando RERANK_ENABLED=true, para que la primera petición no pague el arranque en frío.
RERANK_PRELOAD=true
