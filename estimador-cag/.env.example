# Copia este archivo a `.env` y rellena la API key del proveedor que vayas a usar.
# `.env` está en .gitignore: nunca se sube al repositorio.

# Proveedor LLM: openai | anthropic
LLM_PROVIDER=openai

# API keys (solo hace falta la del proveedor elegido)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos económicos recomendados por el curso
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Parámetros del modelo
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
