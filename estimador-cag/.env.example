# Copia este archivo a `.env` y rellena la API key del proveedor que vayas a usar.
# `.env` está en .gitignore: nunca se sube al repositorio.

# Proveedor LLM: openai | anthropic
LLM_PROVIDER=openai

# API keys (solo hace falta la del proveedor elegido)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos económicos recomendados por el curso
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Versión de la plantilla de prompt (carpeta prompts/estimacion/<versión>). Para cambiar el prompt
# se crea una versión nueva y se activa aquí; una petición puede pedir otra con "prompt_version".
PROMPT_VERSION=v3

# Sesiones conversacionales (sesión 05): turnos (par user+assistant) que conserva la ventana deslizante
# del historial de cada sesión, y tope de sesiones vivas en memoria del proceso.
SESSION_MAX_TURNS=6
SESSION_MAX_SESSIONS=500

# Adjuntos (PDF, Word .docx, texto): ficheros por petición, bytes por fichero y caracteres extraídos por fichero
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_CHARS=20000

# URL de la API para la interfaz de Streamlit (streamlit_app.py habla con la API por HTTP)
API_BASE_URL=http://localhost:8000

# Parámetros del modelo
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Precios en USD por millón de tokens, para calcular el coste de cada llamada.
# Opcionales: si no se definen se usa la tabla de app/services/pricing.py según el modelo.
# LLM_INPUT_PRICE_PER_MTOK=0.15
# LLM_OUTPUT_PRICE_PER_MTOK=0.60
